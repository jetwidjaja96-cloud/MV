    "def load_data(data_dir, dim=DIM):\n",
    "    ds = tf.keras.utils.image_dataset_from_directory(\n",
    "        data_dir, labels='inferred', label_mode='int',\n",
    "        image_size=(dim, dim), batch_size=None, shuffle=False\n",
    "    )\n",
    "    x = np.array([item[0].numpy() for item in ds])\n",
    "    y = np.array([item[1].numpy() for item in ds])\n",
    "    return x, y\n",
    "\n",
    "# ── Step 1: Load all images the fast way (same as original Cell 3) ────────────\n",
    "print('Loading data at 128×128...')\n",
    "x_train_raw, y_train_int = load_data(TRAIN_DIR)\n",
    "x_test_raw,  y_test_int  = load_data(TEST_DIR)\n",
    "print(f'Train: {len(x_train_raw)} | Test: {len(x_test_raw)}')\n",
    "\n",
    "# ── Step 2: Get filenames in the same order tf.keras loaded them ──────────────\n",
    "# tf.keras loads alphabetically — NORMAL before PNEUMONIA, shuffle=False\n",
    "normal_files    = sorted((Path(TRAIN_DIR) / 'NORMAL').glob('*.jpeg'))\n",
    "pneumonia_files = sorted((Path(TRAIN_DIR) / 'PNEUMONIA').glob('*.jpeg'))\n",
    "all_train_files = list(normal_files) + list(pneumonia_files)\n",
    "\n",
    "# Build mask — True = keep, False = viral (exclude)\n",
    "is_bacterial = np.array([\n",
    "    True if 'NORMAL' in str(f.parent).upper()\n",
    "    else 'BACTERIA' in f.name.upper()\n",
    "    for f in all_train_files\n",
    "])\n",
    "\n",
    "viral_count = int((~is_bacterial & (y_train_int == 1)).sum())\n",
    "\n",
    "# ── Step 3: Preprocess all images ─────────────────────────────────────────────\n",
    "x_train_gray = to_gray(x_train_raw); del x_train_raw\n",
    "x_test_gray  = to_gray(x_test_raw);  del x_test_raw\n",
    "\n",
    "print('Preprocessing train...')\n",
    "x_train_all = np.zeros((len(x_train_gray), DIM, DIM), dtype=np.float32)\n",
    "for i in tqdm(range(len(x_train_gray)), desc='Train'):\n",
    "    x_train_all[i] = preprocess_xray(x_train_gray[i])\n",
    "del x_train_gray\n",
    "\n",
    "print('Preprocessing test...')\n",
    "x_test = np.zeros((len(x_test_gray), DIM, DIM), dtype=np.float32)\n",
    "for i in tqdm(range(len(x_test_gray)), desc='Test'):\n",
    "    x_test[i] = preprocess_xray(x_test_gray[i])\n",
    "del x_test_gray\n",
    "\n",
    "# ── Step 4: Filter to bacterial only ─────────────────────────────────────────\n",
    "x_train = x_train_all[is_bacterial]; del x_train_all\n",
    "y_ints  = y_train_int[is_bacterial]\n",
    "\n",
    "y_train = to_categorical(y_ints,       num_classes=NUM_CLASSES)\n",
    "y_test  = to_categorical(y_test_int,   num_classes=NUM_CLASSES)\n",
    "\n",
    "print(f'\\nx_train shape : {x_train.shape}')\n",
    "print(f'Normal        : {(y_ints==0).sum()}')\n",
    "print(f'Bacterial     : {(y_ints==1).sum()}  ← kept')\n",
    "print(f'Viral         : {viral_count}          ← excluded')\n",
    "print(f'Class ratio   : 1 : {(y_ints==1).sum()/(y_ints==0).sum():.2f}')"
   ]
