    "from scipy.ndimage import gaussian_filter\n",
    "\n",
    "def patient_specific_residual(recon_img, sigma=5.0):\n",
    "    \"\"\"\n",
    "    Subtract a smooth (very low frequency) version of the image\n",
    "    from itself — removes the individual patient baseline\n",
    "    while preserving consolidation-scale content.\n",
    "    \n",
    "    sigma controls the spatial scale of the baseline:\n",
    "    - large sigma (8-15 px) captures the slow background variation\n",
    "    - consolidation has finer spatial scale — survives the subtraction\n",
    "    \"\"\"\n",
    "    # Individual patient baseline — very smooth version\n",
    "    baseline = gaussian_filter(recon_img, sigma=sigma)\n",
    "    \n",
    "    # Residual — what is left after removing the patient's own baseline\n",
    "    residual = recon_img - baseline\n",
    "    \n",
    "    # Keep positive — brighter than own baseline\n",
    "    return np.maximum(residual, 0)\n",
    "\n",
    "# Apply to all images — no reference needed\n",
    "residuals_self = np.array([\n",
    "    patient_specific_residual(recon_imgs[i], sigma=8.0)\n",
    "    for i in range(len(recon_imgs))\n",
    "])\n",
    "\n",
    "# Now compute Fisher ratio\n",
    "res_n = residuals_self[y_ints==0].mean(axis=(1,2))\n",
    "res_p = residuals_self[y_ints==1].mean(axis=(1,2))\n",
    "fisher = (res_p.mean()-res_n.mean())**2 / (res_p.std()**2+res_n.std()**2+1e-8)\n",
    "print(f'Self-normalised Fisher: {fisher:.4f}')"
