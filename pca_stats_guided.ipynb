    "# ── Normalised residual computation ───────────────────────────────────────────\n",
    "reference_mean_val = reference_img.mean()\n",
    "\n",
    "def normalised_residual(recon_img, reference_img):\n",
    "    \"\"\"\n",
    "    Scale each image so its mean matches the reference mean\n",
    "    before subtracting — removes individual brightness offset.\n",
    "    Consolidation survives because it is a local brightness increase,\n",
    "    not a global one. A globally bright healthy image gets scaled down\n",
    "    to near zero residual. A pneumonia image gets scaled down globally\n",
    "    but retains the locally bright consolidation region.\n",
    "    \"\"\"\n",
    "    img_mean = recon_img.mean()\n",
    "    if img_mean > 1e-8:\n",
    "        scale        = reference_mean_val / img_mean\n",
    "        recon_scaled = recon_img * scale\n",
    "    else:\n",
    "        recon_scaled = recon_img\n",
    "    return np.maximum(recon_scaled - reference_img, 0)\n",
    "\n",
    "print('Computing normalised residuals...')\n",
    "speckles = np.array([\n",
    "    normalised_residual(recon_unhealthy[i], reference_img)\n",
    "    for i in range(len(recon_unhealthy))\n",
    "], dtype=np.float32)\n",
    "\n",
    "healthy_diff = np.array([\n",
    "    normalised_residual(recon_healthy[i], reference_img)\n",
    "    for i in range(len(recon_healthy))\n",
    "], dtype=np.float32)\n",
    "\n",
    "# Quick check\n",
    "mean_s = speckles.mean(axis=(1,2))\n",
    "mean_h = healthy_diff.mean(axis=(1,2))\n",
    "fisher = (mean_s.mean()-mean_h.mean())**2 / \\\n",
    "         (mean_s.std()**2+mean_h.std()**2+1e-8)\n",
    "\n",
    "print(f'Healthy mean      : {mean_h.mean():.4f}')\n",
    "print(f'Pneumonia mean    : {mean_s.mean():.4f}')\n",
    "print(f'Ratio             : {mean_s.mean()/mean_h.mean():.2f}x')\n",
    "print(f'Fisher ratio      : {fisher:.4f}')\n",
    "print(f'Previous Fisher   : 1.0453')"
   ]
