    "# ── Geometric Lung Field Mask ─────────────────────────────────────────────────\n",
    "\n",
    "DIM = 128\n",
    "\n",
    "from scipy.ndimage import gaussian_filter\n",
    "\n",
    "def make_soft_lung_mask(dim=128, row_top=0.18, row_bot=0.82,\n",
    "                         col_exclude=0.08, col_left=0.04,\n",
    "                         col_right=0.96, sigma=2.0):\n",
    "    \"\"\"Same as hard mask but with soft feathered edges.\"\"\"\n",
    "    mask = np.zeros((dim, dim), dtype=np.float32)\n",
    "    centre = dim // 2\n",
    "    r_top  = int(dim * row_top);  r_bot  = int(dim * row_bot)\n",
    "    excl   = int(dim * col_exclude)\n",
    "    c_left = int(dim * col_left); c_rght = int(dim * col_right)\n",
    "\n",
    "    mask[r_top:r_bot, c_left      : centre - excl] = 1.0\n",
    "    mask[r_top:r_bot, centre+excl : c_rght        ] = 1.0\n",
    "\n",
    "    # Feather edges — removes hard boundary artefacts\n",
    "    mask = gaussian_filter(mask, sigma=sigma)\n",
    "    mask = mask / mask.max()   # renormalise to [0,1]\n",
    "    return mask\n",
    "\n",
    "LUNG_MASK = make_soft_lung_mask(DIM, sigma=2.0)\n",
    "\n",
    "# ── Apply mask ────────────────────────────────────────────────────────────────\n",
    "speckles_masked   = speckles    * LUNG_MASK[np.newaxis]\n",
    "healthy_diff_masked = healthy_diff * LUNG_MASK[np.newaxis]\n",
    "\n",
    "# ── Fisher ratio comparison ───────────────────────────────────────────────────\n",
    "mean_s_raw    = speckles.mean(axis=(1,2))\n",
    "mean_h_raw    = healthy_diff.mean(axis=(1,2))\n",
    "mean_s_masked = speckles_masked.mean(axis=(1,2))\n",
    "mean_h_masked = healthy_diff_masked.mean(axis=(1,2))\n",
    "\n",
    "fisher_raw    = (mean_s_raw.mean()    - mean_h_raw.mean())**2    / \\\n",
    "                (mean_s_raw.std()**2  + mean_h_raw.std()**2 + 1e-8)\n",
    "fisher_masked = (mean_s_masked.mean() - mean_h_masked.mean())**2 / \\\n",
    "                (mean_s_masked.std()**2 + mean_h_masked.std()**2 + 1e-8)\n",
    "\n",
    "print('=' * 52)\n",
    "print('LUNG MASK — FISHER RATIO COMPARISON')\n",
    "print('=' * 52)\n",
    "print(f'{\"\":22}  {\"Unmasked\":>10}  {\"Masked\":>10}')\n",
    "print('-' * 52)\n",
    "print(f'{\"Healthy mean\":22}  {mean_h_raw.mean():10.4f}  '\n",
    "      f'{mean_h_masked.mean():10.4f}')\n",
    "print(f'{\"Pneumonia mean\":22}  {mean_s_raw.mean():10.4f}  '\n",
    "      f'{mean_s_masked.mean():10.4f}')\n",
    "print(f'{\"Delta\":22}  '\n",
    "      f'{mean_s_raw.mean()-mean_h_raw.mean():10.4f}  '\n",
    "      f'{mean_s_masked.mean()-mean_h_masked.mean():10.4f}')\n",
    "print(f'{\"Ratio (P/H)\":22}  '\n",
    "      f'{mean_s_raw.mean()/mean_h_raw.mean():10.2f}x  '\n",
    "      f'{mean_s_masked.mean()/mean_h_masked.mean():10.2f}x')\n",
    "print(f'{\"Fisher ratio\":22}  {fisher_raw:10.4f}  {fisher_masked:10.4f}')\n",
    "print('=' * 52)\n",
    "\n",
    "# ── Visual check — overlay mask on sample images ──────────────────────────────\n",
    "fig, axes = plt.subplots(2, 5, figsize=(22, 9))\n",
    "\n",
    "#np.random.seed(42)\n",
    "h_idx = np.random.choice(len(healthy_diff),  5, replace=False)\n",
    "p_idx = np.random.choice(len(speckles),      5, replace=False)\n",
    "\n",
    "vmax = max(speckles_masked[p_idx].max(),\n",
    "           healthy_diff_masked[h_idx].max())\n",
    "\n",
    "for col in range(5):\n",
    "    axes[0, col].imshow(healthy_diff_masked[h_idx[col]],\n",
    "                        cmap='gray', vmin=0, vmax=vmax)\n",
    "    axes[0, col].set_title(f'Healthy #{col+1}\\n'\n",
    "                            f'mean={healthy_diff_masked[h_idx[col]].mean():.4f}',\n",
    "                            fontsize=8)\n",
    "    axes[0, col].axis('off')\n",
    "\n",
    "    axes[1, col].imshow(speckles_masked[p_idx[col]],\n",
    "                        cmap='gray', vmin=0, vmax=vmax)\n",
    "    axes[1, col].set_title(f'Pneumonia #{col+1}\\n'\n",
    "                            f'mean={speckles_masked[p_idx[col]].mean():.4f}',\n",
    "                            fontsize=8)\n",
    "    axes[1, col].axis('off')\n",
    "\n",
    "axes[0, 0].set_ylabel('Healthy diff\\n(masked)', fontsize=9, fontweight='bold')\n",
    "axes[1, 0].set_ylabel('Pneumonia diff\\n(masked)', fontsize=9, fontweight='bold')\n",
    "\n",
    "plt.suptitle(f'Lung Field Masked Residuals\\n'\n",
